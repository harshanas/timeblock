{
  "name": "timeblocks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply timeblocks --local",
    "db:migrate:remote": "wrangler d1 migrations apply timeblocks --remote",
    "set-password": "node scripts/set-password.mjs",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.158.0"
  }
}
